# Modalità operativa: "paper" (simulazione sicura su prezzi reali) oppure "live" (ordini reali su exchange)
TRADING_MODE=paper

# Exchange primario supportato da CCXT: kraken, bybit, kucoin, coinbase, bitget, binance
# Nota: Su GitHub Actions (server USA), "kraken" o "coinbase" funzionano senza blocchi geografici.
EXCHANGE_ID=kraken

# Credenziali API (necessarie SOLO se TRADING_MODE=live; su GitHub inseriscile in Settings -> Secrets -> Actions)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_PASSWORD=
